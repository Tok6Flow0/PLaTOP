{
  "name": "platop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A small local 3D playground for your AI teams.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/build-fingerprint.mjs --build",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "desktop:build": "bash scripts/build-macos.sh",
    "desktop": "bash scripts/run-macos.sh",
    "status": "node scripts/platop.mjs"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@types/three": "^0.180.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
